<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat message root.

  Designed to host many message styles via View visibility toggling:
   • userTextView    — user simple text bubble
   • aiHeader        — small "AI · TalkToMuch" label + avatar
   • aiStatusBadge   — green/blue chip ("Câu đúng" / "Câu cần sửa")
   • aiTextView      — primary AI message text
   • correctionCard  — light-blue correction sub-card with chip + sentence + play btn
   • questionCard    — light-green question sub-card with chip + sentence
   • metaRow         — small timestamp / replay
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <!-- ===== AI bubble column (left aligned, with avatar) ===== -->
    <LinearLayout
        android:id="@+id/aiBubbleColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="40dp"
        android:orientation="vertical">

        <!-- AI header row (avatar + meta) -->
        <LinearLayout
            android:id="@+id/aiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_avatar_ai">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai_sparkle" />
            </FrameLayout>

            <TextView
                android:id="@+id/aiMetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:text="@string/ai_meta_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/aiTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                tools:ignore="HardcodedText"
                xmlns:tools="http://schemas.android.com/tools"
                android:text="10:24" />
        </LinearLayout>

        <!-- Bubble container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_ai"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <!-- Status badge row (correct / incorrect) -->
            <LinearLayout
                android:id="@+id/aiStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip_correct"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/aiStatusIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/aiStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/ai_status_correct"
                    android:textColor="@color/brand_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Explanation header (label) -->
            <LinearLayout
                android:id="@+id/explanationHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai_sparkle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="@string/grammar_explanation_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Main AI text (explanation) -->
            <TextView
                android:id="@+id/aiTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:lineSpacingMultiplier="1.2"
                android:textAppearance="@style/TextAppearance.TalkToMuch.Bubble"
                tools:text="Mình đã sửa giúp bạn một chút nhé:"
                xmlns:tools="http://schemas.android.com/tools" />

            <!-- Correction card (light blue) -->
            <LinearLayout
                android:id="@+id/correctionCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_correction_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_edit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/ai_corrected_title"
                        android:textColor="@color/brand_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/correctedSentenceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxWidth="240dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="&quot;I went to the park yesterday.&quot;"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>

            <!-- Question card (light green) -->
            <LinearLayout
                android:id="@+id/questionCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_question_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_question" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/ai_question_title"
                        android:textColor="@color/brand_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxWidth="240dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="What did you do at the park?"
                    xmlns:tools="http://schemas.android.com/tools" />
            </LinearLayout>

            <!-- "Đọc chậm" (slow replay) action — placed OUTSIDE correctionCard,
                 at the bottom of the AI bubble so it visually belongs to the
                 whole reply, not to the "Câu sửa" sub-card. Slate/neutral tone
                 distinguishes it from blue correction card and green question card. -->
            <LinearLayout
                android:id="@+id/correctedSentencePlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_play_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_volume_slate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:text="@string/ai_play"
                    android:textColor="#0E1A2B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Meta row below AI bubble -->
        <LinearLayout
            android:id="@+id/metaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_waveform" />

            <TextView
                android:id="@+id/metaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Đã phát lại"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== User bubble (right aligned, simple) ===== -->
    <LinearLayout
        android:id="@+id/userBubbleColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="40dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/userBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_user"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/userTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:textAppearance="@style/TextAppearance.TalkToMuch.Bubble"
                android:textColor="@color/text_on_primary"
                tools:text="I go to the park yesterday."
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <TextView
            android:id="@+id/userTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="6dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools"
            android:text="10:25" />
    </LinearLayout>

    <!-- ===== Date pill (center) ===== -->
    <TextView
        android:id="@+id/datePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_date_pill"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/date_today"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible"
        xmlns:tools="http://schemas.android.com/tools" />
</FrameLayout>
