<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Base application theme (Material 3, light) ===== -->
    <style name="Base.Theme.Talktoomuch" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary</item>

        <!-- Secondary (green) -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/on_brand_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_secondary</item>

        <!-- Surface / background -->
        <item name="android:colorBackground">@color/surface_dim</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_container</item>
        <item name="colorOutline">@color/surface_outline</item>
        <item name="colorOutlineVariant">@color/surface_outline_variant</item>

        <!-- Error -->
        <item name="colorError">@color/accent_error</item>

        <!-- System bars: window is white so the status bar matches the top bar.
             The root ViewGroup then paints surface_dim only on the body area below the top bar. -->
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_dim</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Typography defaults -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.TalkToMuch.Button</item>
    </style>

    <style name="Theme.Talktoomuch" parent="Base.Theme.Talktoomuch" />

    <!-- ===== Component styles ===== -->

    <!-- Pill button (used for send button) -->
    <style name="Widget.TalkToMuch.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">22dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.TalkToMuch.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.TalkToMuch.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Chat bubble text appearance -->
    <style name="TextAppearance.TalkToMuch.Bubble" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.TalkToMuch.Bubble.User">
        <item name="android:textColor">@color/text_on_primary</item>
    </style>

    <style name="TextAppearance.TalkToMuch.Meta" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.TalkToMuch.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.TalkToMuch.BrandTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
    </style>

</resources>
