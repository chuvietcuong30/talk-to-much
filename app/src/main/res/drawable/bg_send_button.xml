<?xml version="1.0" encoding="utf-8"?>
<!-- Blue send button: solid blue circle with soft shadow + ripple -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft shadow layer -->
    <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="-2dp">
        <shape android:shape="oval">
            <solid android:color="#1A0B57D0" />
        </shape>
    </item>

    <!-- Main blue circle -->
    <item android:top="0dp" android:bottom="2dp">
        <ripple android:color="#33000000">
            <item android:id="@android:id/mask">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/brand_primary" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
