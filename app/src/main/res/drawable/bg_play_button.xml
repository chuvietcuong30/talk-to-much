<?xml version="1.0" encoding="utf-8"?>
<!--
  "Đọc chậm" (slow replay) pill button.

  Tone-on-tone blue:
   • correction card uses brand_primary_container (light blue)
   • question card uses brand_secondary_container (light green)
   • this button uses a TINTED VIOLET/SLATE grey (text_secondary_low) at ~12% alpha
     so it feels like a neutral "action" pill, distinct from the two info cards.

  Ripple mask matches pill outline (rounded rectangle, 16dp).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22000000">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E3EAF3" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#C9D4E2" />
        </shape>
    </item>
</ripple>
